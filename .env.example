# Bright Data — SERP API (same pattern as unfancy-search)
BRIGHT_DATA_API_TOKEN=your_bright_data_api_token_here
BRIGHT_DATA_SERP_ZONE=serp_api1

# LLM — optional, for narrative synthesis (OpenAI-compatible)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

PORT=3000

# MongoDB Atlas — optional, enables prediction caching (24h TTL)
# Free M0 tier: https://cloud.mongodb.com
MONGODB_URI=
